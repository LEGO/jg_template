{{- if ne .include_ray "yes" -}}
  {{- skip (printf "src/%s/model/train_model_ray.py" .data_product_name) -}}
  {{- skip "src/common/ray_helper.py" -}}
  {{- skip (printf "resources/%s/model_training_ray.yml" .data_product_name) -}}
{{- end -}}
{{- if ne .include_hyperparameter_tuning "yes" -}}
  {{- skip (printf "src/%s/model/tune_model_ray.py" .data_product_name) -}}
  {{- skip (printf "resources/%s/model_tuning.yml" .data_product_name) -}}
{{- end -}}
{{- if ne .include_serving "yes" -}}
  {{- skip (printf "src/%s/model/serve.py" .data_product_name) -}}
{{- end -}}
{{- if ne .include_batch_prediction "yes" -}}
  {{- skip (printf "src/%s/batch_prediction.py" .data_product_name) -}}
{{- end -}}
{{- if ne .include_data_monitoring "yes" -}}
  {{- skip "src/data_monitoring" -}}
  {{- skip "tests/test_data_monitor.py" -}}
{{- end -}}
# The automation bundle is compliant with level 2 of https://baseplate.legogroup.io/catalog/default/component/ds_ai_handbook/docs/traditional_ml/docs/maturity_levels/6-mlops-continuous-delivery/#continuous-delivery.
#
# Explanation:
# CD1) The bundle orchestrates  all the necessary components for a complete ML pipeline in the right order with workflows.
# CD2) Deployment with a CI/CD tool deploys source code to cloud infrastructure easily ensuring symmetry between environments.

bundle:
  name: {{.data_product_name}}

include:
  - resources/*.yml
  - resources/**/*.yml

artifacts:
  default:
    dynamic_version: true 
    type: whl
    build: uv build
    path: .

variables: #NOTE Defined at the bundle level to be shared across all jobs, and can be overridden at the target level if needed.
  environment:
    description: The deployment environment
  catalog:
    description: The catalog to use (defaults to the data product name)
    default: {{.data_product_name}}
  schema:
    description: The schema to use
    default: {{.schema}}
  {{.data_product_name}}_source_table:
    description: >-
      Fully-qualified raw source table the preprocessing job reads. Defaults to the shared
      sandbox table so the example runs regardless of the chosen catalog/product name.
    default: ai_enablement.general_resources.anime_bronze
  {{.data_product_name}}_feature_store_table_name:
    description: The name of the feature store table
    default: anime_features
  {{.data_product_name}}_batch_prediction_table:
    description: The name of the batch prediction table
    default: ${var.{{.data_product_name}}_model_name}_batch_predictions
  {{.data_product_name}}_model_name:
    description: The name of the registered model (example default; rename for your product)
    default: anime_score_predictor
  {{.data_product_name}}_experiment_path:
    description: The path to the mlflow experiment
    default: /Shared/{{.data_product_name}}/${var.environment}/${workspace.current_user.userName}/${var.{{.data_product_name}}_model_name}
  data_monitoring_assets_dir:
    description: Team-shared workspace folder for the data monitor's generated assets
    default: /Shared/{{.data_product_name}}/${var.environment}/data_monitoring
  pause_status:
    description: The default pause status for jobs
  policy_id:
    description: Policy ID for cluster
    lookup:
      cluster_policy: Job Cluster Policy
  databricks_host:
    description: The Databricks workspace host URL
  secret_scope:
    description: The secret scope for the deployment environment
  permission_group:
    description: Databricks permission group to grant access to the deployed assets
    default: c1.app.access.sscdp.aiops_dev.developer

targets:
  # local: local development via Databricks CLI / VSCode extension. Per-user prefix isolates assets.
  local:
    mode: development
    default: true
    presets:
      name_prefix: '[${workspace.current_user.short_name}] '
    workspace:
      host: https://lego-ssc-dev.cloud.databricks.com
    variables:
      environment: dev
      pause_status: PAUSED
      policy_id: A963D86B02001DC8
      databricks_host: https://lego-ssc-dev.cloud.databricks.com
      secret_scope: ${var.catalog}.dev.sp.secret_scope
      {{.data_product_name}}_experiment_path: /Shared/{{.data_product_name}}/${var.environment}/${workspace.current_user.short_name}/${var.{{.data_product_name}}_model_name}

  # dev/qa/prod: deployed only through GitHub Actions (service principal).
  dev:
    mode: development
    workspace:
      host: https://lego-ssc-dev.cloud.databricks.com
    variables:
      environment: dev
      pause_status: PAUSED
      policy_id: A963D86B02001DC8
      databricks_host: https://lego-ssc-dev.cloud.databricks.com
      secret_scope: ${var.catalog}.dev.sp.secret_scope

  qa:
    mode: production
    workspace:
      host: https://lego-ssc-qa.cloud.databricks.com
      root_path: /Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
    variables:      
      environment: qa
      pause_status: PAUSED
      policy_id: A96377E9F70003FA
      databricks_host: https://lego-ssc-qa.cloud.databricks.com
      secret_scope: ${var.catalog}.qa.sp.secret_scope

  prod:
    mode: production
    workspace:
      host: https://lego-ssc-prod.cloud.databricks.com
      root_path: /Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
    variables:
      environment: prod
      pause_status: UNPAUSED
      policy_id: A96377E9F70003FE
      databricks_host: https://lego-ssc-prod.cloud.databricks.com
      secret_scope: ${var.catalog}.prod.sp.secret_scope
