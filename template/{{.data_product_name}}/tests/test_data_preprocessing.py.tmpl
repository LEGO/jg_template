"""Tests for the LEGO feature-engineering steps (local Spark session)."""

import pytest
from pyspark.sql import SparkSession

from {{.data_product_name}}.data_preprocessing import (
    _optional_year,
    alter_table_with_comments,
    apply_year_window,
    build_category_vocabulary,
    build_feature_frame,
    create_category_onehot_encodings,
    deduplicate_on_key,
    drop_invalid_rows,
    filter_buildable_sets,
    fix_data_types,
    to_column_name,
)

BRONZE_COLUMNS = ["set_number", "year_released", "number_of_parts", "theme_name"]


@pytest.fixture(scope="module")
def spark():
    session = (
        SparkSession.builder.appName("test_data_preprocessing")
        .master("local[1]")
        .config("spark.sql.shuffle.partitions", "1")
        # DBR 17.x is Spark 4-based and enables ANSI mode by default, whereas local
        # pyspark 3.5 disables it. Without this, a bad numeric cast passes here and
        # fails on the cluster.
        .config("spark.sql.ansi.enabled", "true")
        .getOrCreate()
    )
    yield session
    session.stop()


def _bronze(spark, rows):
    """Builds an all-STRING frame, matching the real bronze table's contract."""
    return spark.createDataFrame(rows, BRONZE_COLUMNS)


def test_fix_data_types_casts_decimal_strings(spark):
    # Bronze stores these as text with a trailing '.0'. Under ANSI mode a direct
    # string->int cast on "1965.0" RAISES CAST_INVALID_INPUT, so this guards the
    # double-then-int route. Fails if anyone "simplifies" it to a single cast.
    df = _bronze(spark, [("001-1", "1965.0", "43.0", "Technic")])
    out = fix_data_types(df, target_name="number_of_parts", numeric_features=["year_released"]).collect()[0]

    assert out["year_released"] == 1965
    assert out["number_of_parts"] == pytest.approx(43.0)


def test_drop_invalid_rows_removes_theme_only_rows(spark):
    # Bronze contains 7 rows where every field is empty except theme_name.
    df = _bronze(spark, [
        ("001-1", "1965.0", "43.0", "Technic"),
        ("", "", "", "Pirates"),
    ])
    out = drop_invalid_rows(df, id_column="set_number", target_name="number_of_parts")

    assert [r["set_number"] for r in out.collect()] == ["001-1"]


def test_drop_invalid_rows_removes_blank_target_with_valid_id(spark):
    # The optimizer cannot save this row: a valid id means no pushed-down predicate
    # removes it before the cast. Guards the ANSI CAST_INVALID_INPUT crash directly.
    df = _bronze(spark, [
        ("001-1", "1965.0", "43.0", "Technic"),
        ("999-1", "1980.0", "", "Space"),
    ])
    out = drop_invalid_rows(df, id_column="set_number", target_name="number_of_parts")

    assert [r["set_number"] for r in out.collect()] == ["001-1"]


def test_blank_rows_are_dropped_before_casting(spark):
    # Order matters: drop first, then cast. Reversing these raises CAST_INVALID_INPUT
    # under ANSI mode, which is what the cluster runs.
    df = _bronze(spark, [
        ("001-1", "1965.0", "43.0", "Technic"),
        ("999-1", "1980.0", "", "Space"),
        ("", "", "", "Pirates"),
    ])
    out = fix_data_types(
        drop_invalid_rows(df, id_column="set_number", target_name="number_of_parts"),
        target_name="number_of_parts",
        numeric_features=["year_released"],
    ).collect()

    assert len(out) == 1
    assert out[0]["year_released"] == 1965
    assert out[0]["number_of_parts"] == pytest.approx(43.0)


def test_filter_buildable_sets_removes_zero_part_merchandise(spark):
    df = _bronze(spark, [
        ("001-1", "1965.0", "43.0", "Technic"),
        ("kc-1", "2015.0", "0.0", "Key Chain"),
    ])
    df = fix_data_types(df, "number_of_parts", ["year_released"])
    out = filter_buildable_sets(df, target_name="number_of_parts")

    assert [r["set_number"] for r in out.collect()] == ["001-1"]


def test_deduplicate_on_key_leaves_one_row_per_id(spark):
    # upsert_delta_table MERGEs on this key; Delta MERGE fails when several source
    # rows match one target row.
    df = _bronze(spark, [
        ("001-1", "1965.0", "43.0", "Technic"),
        ("001-1", "1965.0", "43.0", "Technic"),
    ])
    out = deduplicate_on_key(df, id_column="set_number")

    assert out.count() == 1


def test_to_column_name_matches_anime_behaviour_for_ordinary_names():
    # The anime example replaced spaces only; ordinary theme names must come out
    # byte-identical so the existing naming pattern is preserved.
    assert to_column_name("Star Wars") == "Star_Wars"
    assert to_column_name("Technic") == "Technic"
    assert to_column_name("Classic Town") == "Classic_Town"


def test_to_column_name_neutralises_the_dot_hazard():
    # Theme "4.5V" is inside the top 100. A '.' in a column name is read by Spark as
    # nested-field access, so select("4.5V") would break.
    assert to_column_name("4.5V") == "4_5V"
    assert to_column_name("Bricks & More") == "Bricks_More"
    assert to_column_name("HO 1:87 Vehicles") == "HO_1_87_Vehicles"
    assert to_column_name("Spider-Man") == "Spider_Man"


def test_build_category_vocabulary_breaks_count_ties_by_name(spark):
    # The real 100th and 101st themes both have 39 sets, so the tie-break is
    # load-bearing: without it the feature schema changes between runs.
    #
    # NOTE the row order below is deliberate and load-bearing too. "Beta" is inserted
    # BEFORE "Alpha" so that Spark's own aggregation order disagrees with the expected
    # result. Insert them alphabetically instead and this test passes even with the
    # tie-break removed — verified by deleting `.asc()` and seeing it stay green across
    # local[1] through local[8]. Do not "tidy" these rows into alphabetical order.
    rows = [("s1", "1990.0", "10.0", "Zebra"), ("s2", "1990.0", "10.0", "Zebra"),
            ("s3", "1990.0", "10.0", "Beta"), ("s4", "1990.0", "10.0", "Alpha")]
    vocabulary = build_category_vocabulary(_bronze(spark, rows), "theme_name", top_n=2)

    # Zebra wins on count (2); Alpha beats Beta on value ascending at 1 each.
    assert vocabulary[:2] == ["Zebra", "Alpha"]


def test_build_category_vocabulary_appends_other_when_absent(spark):
    rows = [("s1", "1990.0", "10.0", "Technic")]
    vocabulary = build_category_vocabulary(_bronze(spark, rows), "theme_name", top_n=1)

    assert vocabulary == ["Technic", "Other"]


def test_build_category_vocabulary_does_not_duplicate_a_real_other_theme(spark):
    # "Other" is a genuine LEGO theme (87 sets, rank 46). When it wins a slot it must
    # not also be appended.
    rows = [("s1", "1990.0", "10.0", "Other"), ("s2", "1990.0", "10.0", "Other"),
            ("s3", "1990.0", "10.0", "Technic")]
    vocabulary = build_category_vocabulary(_bronze(spark, rows), "theme_name", top_n=2)

    assert vocabulary.count("Other") == 1
    assert sorted(vocabulary) == ["Other", "Technic"]


def test_create_category_onehot_encodings_is_single_label(spark):
    rows = [("s1", "1990.0", "10.0", "Star Wars"), ("s2", "1990.0", "10.0", "Technic")]
    df, columns = create_category_onehot_encodings(
        _bronze(spark, rows), "theme_name", ["Star Wars", "Technic", "Other"]
    )
    out = {r["set_number"]: r for r in df.collect()}

    assert columns == ["Star_Wars", "Technic", "Other"]
    assert [out["s1"][c] for c in columns] == [1, 0, 0]
    assert [out["s2"][c] for c in columns] == [0, 1, 0]
    assert "_bucketed_category" not in df.columns


def test_unknown_and_real_other_themes_share_the_other_column(spark):
    # 188 themes appear only after 2010. They fold into Other alongside the source's
    # own Other theme - deliberately merged, see spec 5.3.
    rows = [("s1", "1990.0", "10.0", "Technic"),
            ("s2", "2015.0", "10.0", "Ninjago"),   # outside the vocabulary
            ("s3", "2015.0", "10.0", "Other")]     # the real Other theme
    df, columns = create_category_onehot_encodings(
        _bronze(spark, rows), "theme_name", ["Technic", "Other"]
    )
    out = {r["set_number"]: r for r in df.collect()}

    assert out["s2"]["Other"] == 1
    assert out["s3"]["Other"] == 1
    assert out["s1"]["Other"] == 0


def test_create_category_onehot_encodings_raises_on_column_collision(spark):
    rows = [("s1", "1990.0", "10.0", "Bricks & More")]
    with pytest.raises(ValueError, match="collision"):
        create_category_onehot_encodings(
            _bronze(spark, rows), "theme_name", ["Bricks & More", "Bricks More"]
        )


def test_apply_year_window_filters_both_bounds_inclusively(spark):
    # s2 and s4 sit exactly on the bounds: this fails if >= becomes > or <= becomes <.
    rows = [("s1", "1970.0", "10.0", "Technic"), ("s2", "2000.0", "10.0", "Technic"),
            ("s3", "2005.0", "10.0", "Technic"), ("s4", "2010.0", "10.0", "Technic"),
            ("s5", "2020.0", "10.0", "Technic")]
    df = fix_data_types(_bronze(spark, rows), "number_of_parts", ["year_released"])
    ids = lambda lo, hi: {r["set_number"] for r in apply_year_window(df, "year_released", lo, hi).collect()}

    assert ids(2000, 2010) == {"s2", "s3", "s4"}
    assert ids(None, None) == {"s1", "s2", "s3", "s4", "s5"}
    assert ids(2000, None) == {"s2", "s3", "s4", "s5"}
    assert ids(None, 2010) == {"s1", "s2", "s3", "s4"}


def test_feature_schema_is_identical_across_year_windows(spark):
    """The schema-churn guard, and it must fail if the vocabulary moves below the window.

    Two disjoint windows whose own top-N themes differ must still produce identical
    columns, because the vocabulary is derived from the whole dataset. Build the
    vocabulary after the window instead and the two frames get different columns.
    """
    rows = [("s1", "1970.0", "10.0", "Technic"), ("s2", "1970.0", "10.0", "Technic"),
            ("s3", "2020.0", "10.0", "Ninjago"), ("s4", "2020.0", "10.0", "Ninjago"),
            ("s5", "2020.0", "10.0", "Friends")]
    column_params = {
        "id": "set_number", "target_name": "number_of_parts",
        "categorical": "theme_name", "top_n_categories": 2,
        "numeric_features": ["year_released"],
    }
    old, old_cols = build_feature_frame(_bronze(spark, rows), column_params, 1949, 1999)
    new, new_cols = build_feature_frame(_bronze(spark, rows), column_params, 2000, 2023)

    assert old.columns == new.columns
    assert old_cols == new_cols
    # Sanity: built per-window, the vocabularies WOULD differ - which is what makes the
    # equality above meaningful rather than vacuous. Asserted on vocabulary content
    # rather than row counts, since a fixture edit could preserve the counts while making
    # both windows share themes, silently making this test vacuous again.
    old_window = apply_year_window(
        fix_data_types(_bronze(spark, rows), "number_of_parts", ["year_released"]), "year_released", 1949, 1999
    )
    new_window = apply_year_window(
        fix_data_types(_bronze(spark, rows), "number_of_parts", ["year_released"]), "year_released", 2000, 2023
    )
    assert build_category_vocabulary(old_window, "theme_name", 2) != \
        build_category_vocabulary(new_window, "theme_name", 2)


def test_build_feature_frame_survives_blank_target_under_ansi(spark):
    # Casting "" to FLOAT raises CAST_INVALID_INPUT under ANSI. If the cast ever moves
    # above the drop inside build_feature_frame, this raises instead of filtering.
    rows = [("001-1", "1965.0", "43.0", "Technic"), ("999-1", "1980.0", "", "Space")]
    column_params = {
        "id": "set_number", "target_name": "number_of_parts",
        "categorical": "theme_name", "top_n_categories": 2,
        "numeric_features": ["year_released"],
    }
    frame, _ = build_feature_frame(_bronze(spark, rows), column_params, None, None)

    assert [r["set_number"] for r in frame.collect()] == ["001-1"]


def test_alter_table_with_comments_backticks_generated_columns():
    """Pins the backtick quoting: theme '4.5V' yields column 4_5V, which is illegal
    unquoted in ALTER TABLE, and the Other column gets the merged-bucket wording."""
    class _RecordingSpark:
        def __init__(self):
            self.statements = []
        def sql(self, statement):
            self.statements.append(statement)

    spark = _RecordingSpark()
    column_params = {
        "id": "set_number", "target_name": "number_of_parts",
        "categorical": "theme_name", "top_n_categories": 100,
        "numeric_features": ["year_released"],
    }
    alter_table_with_comments(spark, "cat.sch.lego_set_features", column_params, ["4_5V", "Other"])

    joined = "\n".join(spark.statements)
    assert "ALTER COLUMN `4_5V`" in joined
    assert "ALTER COLUMN `year_released`" in joined
    # The Other column must document that it merges the source's own Other theme with
    # everything outside the top N, so 23.4% is not mistaken for the source category.
    other_statement = next(s for s in spark.statements if "`Other`" in s)
    assert "top 100" in other_statement


def test_optional_year_treats_empty_and_missing_as_unset():
    # Bundle variables default to "", so the wheel task is invoked with `--min_year=`.
    # Declaring type=int on the argument makes argparse exit non-zero on that value and
    # fails the job on every default deployment.
    assert _optional_year(None) is None
    assert _optional_year("") is None
    assert _optional_year("   ") is None
    assert _optional_year("1999") == 1999
    assert _optional_year(2010) == 2010
