from unittest.mock import MagicMock

import pytest
from databricks.sdk.errors import NotFound

from {{.data_product_name}}.monitoring import setup_monitor

ACTIVE = "MONITOR_STATUS_ACTIVE"
PENDING = "MONITOR_STATUS_PENDING"
ERROR = "MONITOR_STATUS_ERROR"

TABLE = "cat.sch.preds"


def _client():
    return MagicMock()


def _monitor(status: str) -> MagicMock:
    """A MonitorInfo-like object whose `status` is a plain wire string."""
    info = MagicMock()
    info.status = status
    return info


@pytest.fixture(autouse=True)
def _no_sleep(monkeypatch):
    """Keep the status poll from actually waiting between attempts."""
    monkeypatch.setattr(setup_monitor.time, "sleep", lambda _seconds: None)


def _call(client):
    setup_monitor.create_or_update_monitor(
        workspace_client=client,
        table_name=TABLE,
        output_schema_name="cat.sch",
        assets_dir="/Workspace/monitoring",
    )


def test_creates_monitor_when_not_found():
    client = _client()
    # First lookup decides create-vs-update; the second is the status poll.
    client.quality_monitors.get.side_effect = [NotFound("nope"), _monitor(ACTIVE)]

    _call(client)

    client.quality_monitors.create.assert_called_once()
    client.quality_monitors.update.assert_not_called()

    kwargs = client.quality_monitors.create.call_args.kwargs
    assert kwargs["table_name"] == TABLE
    assert kwargs["output_schema_name"] == "cat.sch"
    assert kwargs["assets_dir"] == "/Workspace/monitoring"
    assert kwargs["inference_log"].timestamp_col == "prediction_ts"
    assert kwargs["inference_log"].prediction_col == "Predicted_number_of_parts"
    assert kwargs["inference_log"].model_id_col == "model_version"
    assert kwargs["inference_log"].granularities == ["1 day"]


def test_create_does_not_trigger_redundant_refresh():
    """Databricks refreshes a newly created monitor itself, and refreshing a
    still-PENDING monitor is rejected outright."""
    client = _client()
    client.quality_monitors.get.side_effect = [NotFound("nope"), _monitor(ACTIVE)]

    _call(client)

    client.quality_monitors.run_refresh.assert_not_called()


def test_updates_monitor_when_exists():
    client = _client()
    client.quality_monitors.get.side_effect = [_monitor(ACTIVE), _monitor(ACTIVE)]

    _call(client)

    client.quality_monitors.update.assert_called_once()
    client.quality_monitors.create.assert_not_called()
    client.quality_monitors.run_refresh.assert_called_once_with(table_name=TABLE)


def test_refresh_waits_until_monitor_leaves_pending():
    client = _client()
    client.quality_monitors.get.side_effect = [
        _monitor(ACTIVE),   # existence check
        _monitor(PENDING),  # update pushed it back to pending
        _monitor(PENDING),
        _monitor(ACTIVE),
    ]

    _call(client)

    assert client.quality_monitors.get.call_count == 4
    client.quality_monitors.run_refresh.assert_called_once_with(table_name=TABLE)


def test_raises_and_skips_refresh_when_monitor_reports_failure():
    client = _client()
    client.quality_monitors.get.side_effect = [_monitor(ACTIVE), _monitor(ERROR)]

    with pytest.raises(RuntimeError, match=ERROR):
        _call(client)

    client.quality_monitors.run_refresh.assert_not_called()


def test_wait_times_out_when_monitor_stays_pending():
    client = _client()
    client.quality_monitors.get.return_value = _monitor(PENDING)

    with pytest.raises(TimeoutError):
        setup_monitor._wait_until_active(
            workspace_client=client,
            table_name=TABLE,
            timeout_seconds=0,
            poll_seconds=0,
        )

    client.quality_monitors.run_refresh.assert_not_called()


def test_wait_accepts_enum_status_object():
    """The SDK may return a MonitorInfoStatus enum rather than a raw string."""
    client = _client()
    status = MagicMock()
    status.value = ACTIVE
    client.quality_monitors.get.return_value = _monitor(status)

    setup_monitor._wait_until_active(workspace_client=client, table_name=TABLE)

    assert client.quality_monitors.get.call_count == 1
