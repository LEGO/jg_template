# Ingestion job for data preprocessing in MLOps pipeline.

resources:
  jobs:
    data_preprocessing_job:
      name: ${var.job_name_prefix}${var.{{.data_product_name}}_model_name}_data_preprocessing_job

      schedule:
        quartz_cron_expression: "0 0 4 ? * MON"
        timezone_id: Europe/Copenhagen
        pause_status: ${var.pause_status}

      #email_notifications: #NOTE Uncomment and set your email to receive notifications on job failure.
      #  on_failure:
      #    - your_email@example.com
      
      tasks:
        - task_key: data_processing
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: data_processing_job
            named_parameters: #NOTE named_parameters are parsed or overwritten variables at workflow level.
              catalog_name: ${var.catalog}
              schema_name: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              source_table: ${var.{{.data_product_name}}_source_table}
              feature_store_table_name: ${var.{{.data_product_name}}_feature_store_table_name}
              experiment_path: ${var.{{.data_product_name}}_experiment_path}_data_preprocessing
              baseline_table_name: ${var.{{.data_product_name}}_feature_baseline_table}
              min_year: ${var.{{.data_product_name}}_min_year}
              max_year: ${var.{{.data_product_name}}_max_year}

          job_cluster_key: job_cluster
          libraries:
            - whl: ../../dist/*.whl
{{- if eq .include_data_monitoring "yes" }}

        # Data monitoring runs downstream of preprocessing in the same DAG, attaching a
        # Lakehouse monitor to the feature table just produced by the data_processing task.
        - task_key: data_monitoring
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: data_drift_report_job
            named_parameters:
              catalog_name: ${var.catalog}
              schema_name: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              table_name: ${var.{{.data_product_name}}_feature_store_table_name}
              output_schema_name: ${var.catalog}.${resources.schemas.{{.data_product_name}}_model_schema.name}
              assets_dir: ${var.data_monitoring_assets_dir}
              baseline_table_name: ${var.{{.data_product_name}}_feature_baseline_table}
          job_cluster_key: job_cluster
          libraries:
            - whl: ../../dist/*.whl
          depends_on:
            - task_key: data_processing
{{- end }}

      job_clusters:
        - job_cluster_key: job_cluster
          new_cluster:
            spark_version: 17.3.x-cpu-ml-scala2.13
            node_type_id: i3.2xlarge
            policy_id: ${var.policy_id}
            data_security_mode: SINGLE_USER
            aws_attributes:
              first_on_demand: 1
              zone_id: "auto"
            autoscale:
              min_workers: 4
              max_workers: 8
            spark_conf:
              spark.task.cpus: "2"
              spark.sql.execution.arrow.maxRecordsPerBatch: "100"
              spark.executor.memory: "48g"
              spark.executor.memoryOverhead: "8g"
              spark.driver.memory: "16g"
            custom_tags:
              SOURCE: "table"

      permissions:
        - group_name: ${var.permission_group}
          level: CAN_MANAGE_RUN