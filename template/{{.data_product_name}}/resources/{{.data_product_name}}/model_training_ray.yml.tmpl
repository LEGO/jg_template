# Ray distributed training job for MLOps pipeline.

resources:
  jobs:
    model_training_ray_job:
      name: ${var.job_name_prefix}${var.{{.data_product_name}}_model_name}_ray_training_job

      schedule:
        quartz_cron_expression: "0 0 6 ? * MON"
        timezone_id: Europe/Copenhagen
        pause_status: ${var.pause_status}

      #email_notifications: #NOTE Uncomment and set your email to receive notifications on job failure.
      #  on_failure:
      #    - your_email@example.com

      tasks:
        - task_key: train_model_ray
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: model_training_ray_job
            named_parameters: #NOTE named_parameters are parsed or overwritten variables at workflow level.
              catalog: ${var.catalog}
              schema: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              model_name: ${var.{{.data_product_name}}_model_name}_ray
              feature_store_table_name: ${var.{{.data_product_name}}_feature_store_table_name}
              experiment_path: ${var.{{.data_product_name}}_experiment_path}_model_training_ray
              target_col: Score
              id_col: Name
              num_workers: "2"
              use_gpu: "true"
              num_cpus_worker_node: "3"
              num_gpus_worker_node: "1"
              min_worker_nodes: "2"
              max_worker_nodes: "2"
              memory_worker_node: "6442450944"            # 6 GiB heap per Ray worker
              object_store_memory_worker_node: "2147483648" # 2 GiB object store per Ray worker
              num_cpus_head_node: "2"
              memory_head_node: "4294967296"              # 4 GiB heap on head
              object_store_memory_head_node: "2147483648" # 2 GiB object store on head
              epochs: "30"
              learning_rate: "0.001"
              global_batch_size: "256"
              ray_storage_path: /dbfs/tmp/ray_results/${var.{{.data_product_name}}_model_name}
              ray_log_path: /dbfs/tmp/raylogs/${var.{{.data_product_name}}_model_name}_ray_cluster
              test_size: "0.2"
              random_seed: "42"
          job_cluster_key: ray_gpu_cluster
          libraries:
            - whl: ../../dist/*.whl

      job_clusters:
        - job_cluster_key: ray_gpu_cluster
          new_cluster:
            spark_version: 17.3.x-gpu-ml-scala2.13
            node_type_id: g4dn.xlarge
            policy_id: ${var.policy_id}
            data_security_mode: SINGLE_USER
            # Cap Spark so Ray + Spark together stay under ~80% of worker RAM (16 GiB):
            #   spark.executor.memory (4g) + ray heap (6g) + ray object_store (2g) = 12 GiB
            # Also leave 1 vCPU per worker free for Spark (Ray takes 3 of 4).
            spark_conf:
              "spark.executor.memory": "4g"
              "spark.executor.cores": "1"
              "spark.databricks.pyspark.dataFrameChunk.enabled": "true"
              "spark.task.resource.gpu.amount": "0"
            aws_attributes:
              first_on_demand: 1
              zone_id: "auto"
            autoscale:
              min_workers: 2
              max_workers: 2
            custom_tags:
              SOURCE: "table"

        - job_cluster_key: job_cluster
          new_cluster:
            spark_version: 17.3.x-cpu-ml-scala2.13
            node_type_id: i3.2xlarge
            policy_id: ${var.policy_id}
            data_security_mode: SINGLE_USER
            aws_attributes:
              first_on_demand: 1
              zone_id: "auto"
            autoscale:
              min_workers: 1
              max_workers: 1
            custom_tags:
              SOURCE: "table"

      permissions:
        - group_name: ${var.permission_group}
          level: CAN_MANAGE_RUN
