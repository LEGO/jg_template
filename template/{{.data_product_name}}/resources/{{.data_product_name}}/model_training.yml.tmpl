# Training job for MLOps pipeline.

resources:
  jobs:
    model_training_job:
      name: ${var.job_name_prefix}${var.{{.data_product_name}}_model_name}_training_job

      schedule:
        quartz_cron_expression: "0 0 6 ? * MON"
        timezone_id: Europe/Copenhagen
        pause_status: ${var.pause_status}

      #email_notifications: #NOTE Uncomment and set your email to receive notifications on job failure.
      #  on_failure:
      #    - your_email@example.com

      tasks:        
        - task_key: train_model
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: model_training_job
            named_parameters: #NOTE named_parameters are parsed or overwritten variables at workflow level.
              catalog: ${var.catalog}
              schema: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              model_name: ${var.{{.data_product_name}}_model_name}
              feature_store_table_name: ${var.{{.data_product_name}}_feature_store_table_name}
              experiment_path: ${var.{{.data_product_name}}_experiment_path}_model_training
{{- if eq .include_hyperparameter_tuning "yes" }}
              hyperparameter_experiment_path: ${var.{{.data_product_name}}_experiment_path}_hyperparameter_tuning
{{- end }}
          job_cluster_key: job_cluster
          libraries:
            - whl: ../../dist/*.whl
{{- if eq .include_serving "yes" }}

        - task_key: serve_model
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: model_serving_job
            named_parameters: #NOTE named_parameters are parsed or overwritten variables at workflow level.
              catalog: ${var.catalog}
              schema: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              model_name: ${var.{{.data_product_name}}_model_name}
              serving_endpoint_name: ${var.{{.data_product_name}}_model_name}_endpoint
              databricks_host: ${var.databricks_host}
              permission_group: ${var.permission_group}
              workload_size: Small
              scale_to_zero: "true"
          job_cluster_key: job_cluster
          libraries:
            - whl: ../../dist/*.whl
          depends_on:
            - task_key: train_model
{{- end }}
{{- if eq .include_batch_prediction "yes" }}

        - task_key: batch_prediction_task
          python_wheel_task:
            package_name: {{.data_product_name}}
            entry_point: batch_prediction
            named_parameters: #NOTE named_parameters are parsed or overwritten variables at workflow level.
              catalog_name: ${var.catalog}
              schema_name: ${resources.schemas.{{.data_product_name}}_model_schema.name}
              model_name: ${var.{{.data_product_name}}_model_name}
              feature_store_table_name: ${var.{{.data_product_name}}_feature_store_table_name}
              batch_prediction_table: ${var.{{.data_product_name}}_batch_prediction_table}
              experiment_path: ${var.{{.data_product_name}}_experiment_path}_batch_prediction
          job_cluster_key: job_cluster
          libraries:
            - whl: ../../dist/*.whl
          depends_on:
            - task_key: train_model
{{- end }}

      job_clusters:
        - job_cluster_key: job_cluster
          new_cluster:
            spark_version: 17.3.x-cpu-ml-scala2.13
            node_type_id: i3.2xlarge
            policy_id: ${var.policy_id}
            data_security_mode: SINGLE_USER
            aws_attributes:
              first_on_demand: 1
              zone_id: "auto"
            autoscale:
              min_workers: 1
              max_workers: 1
            custom_tags:
              SOURCE: "table"

      permissions:
        - group_name: ${var.permission_group}
          level: CAN_MANAGE_RUN