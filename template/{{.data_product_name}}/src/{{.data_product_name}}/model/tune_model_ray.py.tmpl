import argparse
from pathlib import Path
from typing import Any

import mlflow
import numpy as np
from mlflow.models import infer_signature
from omegaconf import OmegaConf
import ray.train as ray_train
from ray import tune
from ray.air import RunConfig
from ray.tune.search.optuna import OptunaSearch
from ray.air.integrations.mlflow import MLflowLoggerCallback
from sklearn.ensemble import AdaBoostRegressor
from sklearn.metrics import mean_squared_error

from common.mlflow_helper import set_champion_alias_on_logged_model, start_mlflow_experiment_and_run
from common.spark_helper import get_spark_session
from common.utils import get_logger, load_model_config
from {{.data_product_name}}.model.train_model import prepare_data

logger = get_logger()

config_path = Path(__file__).parent / "model_config.yml"


def _build_search_space(tuning_params: dict) -> dict:
    """Builds a Ray Tune search space from the tuning config.

    Args:
        tuning_params: Tuning section of model_config.yml.

    Returns:
        Dict of Ray Tune search space definitions.
    """
    return {
        "n_estimators": tune.randint(
            tuning_params["n_estimators"]["low"],
            tuning_params["n_estimators"]["high"] + 1,
        ),
        "learning_rate": tune.loguniform(
            tuning_params["learning_rate"]["low"],
            tuning_params["learning_rate"]["high"],
        ),
        "random_state": tuning_params["random_state"]["fixed"],
    }


def tune_model_ray(
    dataframe: Any,
    fully_qualified_model_name: str,
    experiment_path: str,
    model_alias: str = "champion",
) -> None:
    """Runs Ray Tune hyperparameter search for AdaBoostRegressor using OptunaSearch.

    Each trial is logged as a nested MLflow child run via MLflowLoggerCallback.
    After the sweep, the best parameters are used to train a final model which
    is registered and promoted to the given alias.

    Args:
        dataframe: Spark DataFrame containing features and target column.
        fully_qualified_model_name: Unity Catalog model name (catalog.schema.model).
        experiment_path: MLflow experiment path.
        model_alias: Alias to assign to the best registered model version.
    """
    cfg = load_model_config(config_path=config_path)
    column_params: dict = OmegaConf.to_container(cfg.columns, resolve=True)
    tuning_params: dict = OmegaConf.to_container(cfg.tuning, resolve=True)

    n_trials = tuning_params.get("n_trials", 20)

    # Start parent MLflow run to group all trials
    start_mlflow_experiment_and_run(experiment_path)
    parent_run_id = mlflow.active_run().info.run_id
    logger.info(f"Started parent tuning run: {parent_run_id}")

    X_train, X_test, y_train, y_test = prepare_data(dataframe, column_params)
    mlflow.log_param("n_trials", n_trials)

    def trainable(config: dict) -> None:
        """Ray Tune trainable: trains one AdaBoost trial and reports RMSE."""
        model = AdaBoostRegressor(
            n_estimators=config["n_estimators"],
            learning_rate=config["learning_rate"],
            random_state=config["random_state"],
        )
        model.fit(X_train, y_train)
        preds = model.predict(X_test)
        rmse = float(np.sqrt(mean_squared_error(y_test, preds)))
        ray_train.report({"rmse": rmse})

    search_space = _build_search_space(tuning_params)
    searcher = OptunaSearch(metric="rmse", mode="min")

    tuner = tune.Tuner(
        trainable,
        param_space=search_space,
        tune_config=tune.TuneConfig(
            search_alg=searcher,
            num_samples=n_trials,
            metric="rmse",
            mode="min",
        ),
        run_config=RunConfig(
            name="ray_tune_adaboost",
            callbacks=[
                MLflowLoggerCallback(
                    experiment_name=experiment_path,
                    save_artifact=False,
                )
            ],
        ),
    )

    results = tuner.fit()
    best_result = results.get_best_result(metric="rmse", mode="min")
    best_params = best_result.config
    best_rmse = best_result.metrics["rmse"]

    logger.info(f"Best params: {best_params}, RMSE={best_rmse:.4f}")
    mlflow.log_params({f"best_{k}": v for k, v in best_params.items()})
    mlflow.log_metric("best_rmse", best_rmse)

    logger.info("Training final model with best parameters.")
    final_params = {**best_params, "random_state": 42}
    final_model = AdaBoostRegressor(**final_params)
    final_model.fit(X_train, y_train)
    final_preds = final_model.predict(X_test)
    signature = infer_signature(X_train, final_preds)

    mlflow.log_artifact(str(Path(__file__).parent / "model_config.yml"), artifact_path="model_config")

    mlflow.sklearn.log_model(
        sk_model=final_model,
        artifact_path="model",
        signature=signature,
        registered_model_name=fully_qualified_model_name,
    )

    set_champion_alias_on_logged_model(fully_qualified_model_name, model_alias=model_alias)

    mlflow.end_run()


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run Ray Tune hyperparameter tuning pipeline.")
    parser.add_argument("--catalog", required=True, help="Unity Catalog name.")
    parser.add_argument("--schema", required=True, help="Schema name.")
    parser.add_argument("--feature_store_table_name", required=True, help="Name of the feature table.")
    parser.add_argument("--model_name", required=True, help="Registered model name.")
    parser.add_argument("--experiment_path", required=True, help="MLflow experiment path.")
    parser.add_argument("--model_alias", required=False, default="champion", help="Alias for the best model version.")
    return parser.parse_args()


def main() -> None:
    """Entry point for the Ray Tune hyperparameter tuning script."""
    logger.info("Starting Ray Tune hyperparameter tuning pipeline.")
    args = _parse_args()

    spark = get_spark_session(Path(__file__).stem)
    dataframe = spark.read.table(f"{args.catalog}.{args.schema}.{args.feature_store_table_name}")

    tune_model_ray(
        dataframe=dataframe,
        fully_qualified_model_name=f"{args.catalog}.{args.schema}.{args.model_name}",
        experiment_path=args.experiment_path,
        model_alias=args.model_alias,
    )


if __name__ == "__main__":
    main()
